# Copy to agent/.env for `adk web` / `adk run` (ADK loads .env from the agent folder).

# Gemini on Vertex AI. Maps grounding is verified at location "global".
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_USE_ENTERPRISE=True
# Gemini 3.x lets Maps grounding and function tools share one agent.
ADK_MODEL=gemini-3.6-flash

# Data loaded by the notebook or scripts/load.sh
BQ_DATASET=evacuation_readiness
BQ_LOCATION=US
# Views and operational tables built by scripts/build_views.sh (data lane)
OPS_DATASET=readiness_ops
EVAC_STATE=FL
# Demo county: Lee County, FL (Hurricane Ian landfall, 2022)
EVAC_COUNTY_FIPS=12071

# Managed MCP. The challenge requires consuming at least one; set either or both.
# MCP Toolbox for Databases on Cloud Run (scripts/deploy_toolbox.sh prints this URL).
MCP_TOOLBOX_URL=
MCP_TOOLBOX_TOOLSET=evacuation_readiness
# id_token for a private Cloud Run service; none for a local toolbox on localhost
MCP_TOOLBOX_AUTH=id_token
# Maps Grounding Lite (Google-hosted MCP): compute_routes as the drive-time fallback.
# A Maps Demo Key works: https://developers.google.com/maps/demo-key
MAPS_GROUNDING_LITE_API_KEY=
# Google's managed remote BigQuery MCP server (no deployment, uses ADC). Enable the MCP endpoint
# for BigQuery in the project first; check the current BigQuery MCP docs for the command.
BIGQUERY_MCP_ENABLED=false
# Fail at startup instead of warning when no MCP server is configured. Set true for the demo.
REQUIRE_MCP=false

# Live verification: shelters per brief, parallel calls, seconds per call
VERIFY_MAX=8
VERIFY_CONCURRENCY=5
VERIFY_TIMEOUT_S=45
