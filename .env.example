# Copy to .env (git-ignored) and fill in GOOGLE_CLOUD_PROJECT. Everything else is the spec default.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
BQ_DATASET=evacuation_readiness
BQ_LOCATION=US
STATE=FL
MODEL=gemini-3.6-flash
# 1 = every route serves contract/mocks; LIVE_ROUTES switches routes to real code one by one
MOCK_MODE=1
LIVE_ROUTES=
MAX_PARALLEL_VERIFY=6
# UI
API_BASE_URL=http://localhost:8080
USE_MOCK=0
# Maps JavaScript API browser key (referrer-restricted); the web service serves it via /config.js
MAPS_API_KEY=
MAP_ID=DEMO_MAP_ID
